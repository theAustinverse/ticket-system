// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

enum Role {
  USER
  ADMIN
}

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  sessions    Session[]
}

model Session {
  id          String       @id @default(cuid())
  event       Event        @relation(fields: [eventId], references: [id])
  eventId     String
  venue       String
  startTime   DateTime
  batches     SaleBatch[]
  ticketTypes TicketType[]
}

/// A sales wave (e.g. 第一波/第二波/第三波). saleStartAt is nullable because
/// later waves may not have a confirmed start time yet.
model SaleBatch {
  id          String       @id @default(cuid())
  session     Session      @relation(fields: [sessionId], references: [id])
  sessionId   String
  name        String
  saleStartAt DateTime?
  ticketTypes TicketType[]
}

model TicketType {
  id            String     @id @default(cuid())
  session       Session    @relation(fields: [sessionId], references: [id])
  sessionId     String
  batch         SaleBatch  @relation(fields: [batchId], references: [id])
  batchId       String
  name          String
  price         Int
  totalQuantity Int
  /// If set, every order for this ticket type must request exactly this
  /// quantity (e.g. 11 for a group ticket bundle).
  fixedQuantity Int?
  orders        Order[]
}

model Order {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  quantity     Int
  /// Snapshot of quantity * ticketType.price at the time of purchase, so
  /// later price changes don't retroactively affect existing orders.
  totalAmount  Int
  status       OrderStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}
