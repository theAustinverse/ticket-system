// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// The mailbox the address really delivers to (canonicalEmail()): Gmail
  /// ignores dots and "+tag", so a.b@gmail.com and ab+1@gmail.com are one
  /// inbox. Unique, so one person can't register many accounts — and so many
  /// "own seats" — out of one Gmail address. Null only for the accounts that,
  /// when this was added, already shared a mailbox with an older account.
  emailKey     String?  @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  orders       Order[]
  /// Profile fields below are null until the user fills in their settings
  /// page; all four must be set together before they can enter a queue.
  name         String?
  team         String?
  lineId       String?
  phone        String?
  chatMessages ChatMessage[]
  helpQuestions HelpQuestion[]
  transfersSent     TicketTransfer[] @relation("TransferFrom")
  transfersReceived TicketTransfer[] @relation("TransferTo")
  sponsorships      Sponsorship[]
}

enum Role {
  USER
  ADMIN
}

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  sessions    Session[]
}

model Session {
  id          String       @id @default(cuid())
  event       Event        @relation(fields: [eventId], references: [id])
  eventId     String
  venue       String
  startTime   DateTime
  /// Link to the venue's Google Maps place page, if provided.
  mapUrl      String?
  batches     SaleBatch[]
  ticketTypes TicketType[]

  @@index([eventId])
}

/// A sales wave (e.g. 第一波/第二波/第三波). saleStartAt is nullable because
/// later waves may not have a confirmed start time yet.
model SaleBatch {
  id          String       @id @default(cuid())
  session     Session      @relation(fields: [sessionId], references: [id])
  sessionId   String
  name        String
  saleStartAt DateTime?
  /// When this wave's own sale window closes, independent of whether the
  /// next wave has opened yet. Once passed: no more purchases or refunds for
  /// this batch's ticket types, and StockSweepService sweeps whatever's left
  /// (unsold individual stock + group orders' still-blank member seats) into
  /// the next batch at that batch's price. Null means "no fixed close date".
  saleEndAt   DateTime?
  /// After this moment no NEW ticket transfer can be started for this batch's
  /// orders (transfers already PENDING can still be accepted/rejected/cancelled).
  /// Independent of saleEndAt. Null means "no transfer cutoff".
  transferEndAt DateTime?
  /// Wave order within a session is inferred from this (earliest = wave 1).
  createdAt   DateTime     @default(now())
  /// True once this batch's OWN saleEndAt has passed and its leftover stock
  /// has already been swept into the next wave. Idempotency guard for
  /// StockSweepService — lives on the batch being swept FROM, not the one
  /// receiving the sweep.
  stockSweepDone Boolean   @default(false)
  ticketTypes TicketType[]

  @@index([sessionId])
  /// Matches StockSweepService's polling query (due batches: not yet swept, past their close time).
  @@index([stockSweepDone, saleEndAt])
}

model TicketType {
  id            String     @id @default(cuid())
  session       Session    @relation(fields: [sessionId], references: [id])
  sessionId     String
  batch         SaleBatch  @relation(fields: [batchId], references: [id])
  batchId       String
  name          String
  price         Int
  totalQuantity Int
  /// If set, every order for this ticket type must request exactly this
  /// quantity (e.g. 11 for a group ticket bundle).
  fixedQuantity Int?
  /// Only meaningful when fixedQuantity is null (an individual ticket type,
  /// not a group bundle) — lets one order buy 2..N of this ticket in one go
  /// (e.g. an early-bird individual ticket a person can also buy on behalf
  /// of up to 4 family members). Null/1 means the existing one-per-order
  /// behavior for ordinary individual ticket types.
  maxQuantityPerOrder Int?
  /// When set, this ticket type draws from a shared Redis stock pool keyed
  /// by this string instead of its own id — used to split one physical
  /// allotment (e.g. 250 early-bird seats) between a group ticket type
  /// (11/order) and an individual ticket type (1-5/order), whichever sells
  /// first eating into the same pool. Every ticket type sharing a key must
  /// carry the same poolTotalQuantity.
  sharedStockKey String?
  /// Only meaningful when sharedStockKey is set — the true size of the whole
  /// shared pool (e.g. 250), as opposed to totalQuantity which is kept for
  /// display/legacy purposes and may not reflect the shared ceiling.
  poolTotalQuantity Int?
  /// Only meaningful on a shared-pool group ticket type (fixedQuantity set):
  /// hard cap on how many group bundles can ever be sold from the pool,
  /// independent of remaining stock — e.g. 20 bundles (220 of 250 seats),
  /// guaranteeing at least 30 seats stay reachable by individual tickets.
  maxGroupOrders Int?
  /// Gates entry into this ticket type's queue behind a shared passcode
  /// (see QueueRoomService) — e.g. for a group ticket type, so someone who
  /// only holds individual-ticket eligibility can't wander into the group
  /// queue by mistake. The passcode itself is not secret-grade; it's just a
  /// speed bump, not an authorization boundary — orders still record who
  /// bought what for admin review.
  requiresPasscode Boolean @default(false)
  /// Only meaningful on a fixedQuantity bundle: the exact total price the
  /// whole bundle charges, overriding the normal price * quantity math —
  /// e.g. an 11-ticket "buy 10 get 1 free" bundle priced at a flat 23,880
  /// rather than 11 * some per-seat price, which can't land on 23,880
  /// exactly since 23880 isn't divisible by 11. Null means fall back to
  /// price * quantity as usual; every other ticket type is unaffected.
  groupBundleTotalAmount Int?
  createdAt     DateTime   @default(now())
  orders        Order[]

  @@index([sessionId])
  @@index([batchId])
}

model Order {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  quantity     Int
  /// Snapshot of quantity * ticketType.price at the time of purchase, so
  /// later price changes don't retroactively affect existing orders.
  totalAmount  Int
  status       OrderStatus @default(PAID)
  createdAt    DateTime    @default(now())

  registrantName    String
  registrantTeam    String
  registrantLineId  String
  registrantPhone   String
  groupLeaderName   String?
  groupLeaderLineId String?
  groupLeaderPhone  String?
  /// string[] of member names; only used when ticketType.fixedQuantity is set.
  groupMembers      Json?
  /// Companion[] (name, relationship, mealPreference, child-seat need, note).
  /// On a multi-quantity individual ticket type (TicketType.maxQuantityPerOrder):
  /// - buyingForFamily = false: one entry per ticket beyond the buyer's own
  ///   (ticket #1 uses the registrant* fields above).
  /// - buyingForFamily = true: one entry per ticket, quantity entries total —
  ///   every ticket including #1 is on behalf of a family member, so the
  ///   registrant* fields above are just administrative buyer identity, not
  ///   an actual ticket holder.
  companions        Json?
  /// True when this order was placed entirely on behalf of family members —
  /// the buyer self-declares they are already a member of someone else's
  /// group ticket. Self-reported only; not verified against any existing
  /// group-ticket record.
  buyingForFamily   Boolean @default(false)
  /// Survey only (no extra charge): how many child seats this whole order
  /// needs, 0 (default, no need) to 4. One value per order, not per ticket.
  childSeatCount    Int     @default(0)
  /// "葷食" / "素食" / a custom string when the registrant picked "其他".
  /// Defaulted only so existing rows created before this field existed
  /// don't violate NOT NULL; every new order always supplies it explicitly.
  mealPreference    String  @default("未填寫")
  /// Internal note the admin writes in the back office; never shown to users.
  adminNote         String?
  transfers         TicketTransfer[]
  history           OrderHistory[]
  tickets           Ticket[]

  @@index([userId])
  @@index([ticketTypeId])
}

/// Append-only audit trail of everything that happened to an order —
/// self-service edits (registrant info, group members), transfers, and
/// cancellations — so a corrected/overwritten value isn't lost, and admin
/// can see who changed what and when. Cascades with the order on hard
/// delete, same as the order's other child rows.
model OrderHistory {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  action      String
  /// Set when the actor is a registered account (the order owner, or the
  /// other side of a transfer); null for admin-initiated actions, since the
  /// back office login isn't backed by a User row.
  actorUserId String?
  /// Denormalized display label (typically an email) captured at write
  /// time, so this stays meaningful even if the actor's account is later
  /// renamed or deleted.
  actorLabel  String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

/// A whole-order ownership transfer from one registered account to another.
/// Only one PENDING transfer may exist per order at a time (enforced in
/// OrderService, not the DB) — the recipient must accept before Order.userId
/// actually changes; nothing moves on creation alone.
model TicketTransfer {
  /// A partial unique index, "TicketTransfer_orderId_pending_key" on (orderId)
  /// WHERE status = 'PENDING', allows one open invitation per order. It is
  /// defined only in migration 20261009150000 (Prisma's schema language can't
  /// express partial indexes), so `prisma migrate dev` may offer to drop it:
  /// don't accept that.
  id          String               @id @default(cuid())
  /// Cascades with the order/either party on hard delete, same as
  /// OrderHistory. These were ON DELETE RESTRICT, which made an order (or a
  /// user) that had ever been involved in a transfer — even a rejected or
  /// cancelled one — undeletable: AdminService.deleteOrder/deleteUser had
  /// already released the order's stock by the time the delete hit the
  /// constraint, so the seat came back to the pool while the order stayed
  /// live, and every retry released it again. The audit trail of the
  /// transfer survives in OrderHistory, which denormalizes its actor label
  /// precisely so it stays readable after the row it referred to is gone.
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  fromUser    User                 @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId  String
  toUser      User                 @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  toUserId    String
  status      TicketTransferStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  @@index([orderId])
  @@index([fromUserId])
  @@index([toUserId])
}

enum TicketTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// A single post in the site-wide public chat / feedback wall ("心情便利貼").
model ChatMessage {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// Snapshot of the poster's profile name at post time, so the displayed
  /// author doesn't retroactively change if they later edit their profile.
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// One admittable seat on an order — the unit a QR code stands for and the
/// unit that gets checked in at the door. An order always has exactly
/// `quantity` of these, seatIndex 0..quantity-1; which person each seat
/// belongs to is derived at read time from the order's own fields (see
/// src/modules/checkin/ticket-seats.ts), never copied here, so a corrected
/// member/companion name shows up at the door without touching this table.
model Ticket {
  id          String    @id @default(cuid())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  seatIndex   Int
  /// What the QR code encodes: random and unguessable, unlike the order id,
  /// which appears in URLs and is not a secret. Rotated when the order is
  /// transferred, so the previous owner's screenshots stop working.
  token       String    @unique
  /// Set once, atomically (conditional update) — the second scan of the
  /// same seat is refused, which is what makes a forwarded screenshot
  /// useless after the real holder has already come in.
  checkedInAt DateTime?
  /// Name the check-in staff member entered at login (the check-in account
  /// is shared, so this is the only way to tell scanners apart).
  checkedInBy String?
  createdAt   DateTime  @default(now())

  @@unique([orderId, seatIndex])
}

/// A pledge to sponsor the admin team and creators. There is no payment
/// gateway: the sponsor transfers the money themselves using the instructions
/// the page shows (SPONSOR_PAYMENT_INFO), quoting `referenceCode` in the
/// transfer memo, and an admin flips the row to RECEIVED after matching it
/// against the bank statement. So a PENDING row only means "intends to pay".
/// The sponsor's name/email are snapshotted and userId is SET NULL on user
/// delete, so deleting an account never erases a record of money received.
model Sponsorship {
  id            String            @id @default(cuid())
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  donorName     String
  donorEmail    String
  /// Whole NT$.
  amount        Int
  /// 6 digits, unique, for the sponsor to put in the transfer memo.
  referenceCode String            @unique
  status        SponsorshipStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  /// Set when an admin marks it RECEIVED; cleared if they move it back.
  confirmedAt   DateTime?
  /// Set when the sponsor, after transferring, typed the reference code back
  /// to say "I paid and put this code in the memo". The app can't see the
  /// bank memo, so this is the only enforceable form of "must quote the
  /// code": it's a claim to check against the statement, not proof of payment.
  reportedAt    DateTime?

  @@index([userId])
  @@index([status, createdAt])
}

enum SponsorshipStatus {
  PENDING
  RECEIVED
  CANCELLED
}

/// A public contact person ("有問題請聯絡誰"), shown to every visitor on the
/// home page and the 聯絡我們 page. Everything here is public by design: no
/// user link, nothing private. At least one of lineId / email is set (the
/// service enforces it). lineId is either a LINE ID or an https:// link —
/// the frontend only turns it into a link when it is https.
model Contact {
  id        String   @id @default(cuid())
  name      String
  lineId    String?
  email     String?
  /// Ascending; ties fall back to createdAt.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder, createdAt])
}

enum HelpQuestionStatus {
  /// The bot was confident and answered on its own.
  BOT_ANSWERED
  /// The bot was unsure; waiting for the admin (who was emailed).
  ESCALATED
  /// The admin has replied.
  ADMIN_ANSWERED
}

/// A system-operation question put to the help bot (客服小幫手). Private to the
/// asker and the admin — unlike ChatMessage, nobody else sees these.
model HelpQuestion {
  id          String             @id @default(cuid())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// Snapshot of the asker's name at ask time, so the admin list stays readable.
  askerName   String
  question    String
  /// What the bot said (null when it escalated without an answer).
  botAnswer   String?
  status      HelpQuestionStatus
  adminReply  String?
  repliedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
