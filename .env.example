# Copy this file to .env and fill in real values for local development.
# Required unless noted otherwise.

DATABASE_URL="postgresql://ticket:ticket@localhost:5432/ticket_system?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379
# Optional — only needed if Redis requires auth (e.g. in production).
REDIS_PASSWORD=

# Any non-empty string works locally. Must be a real secret in production —
# the app refuses to start without this set at all (see jwt-secret.ts).
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1h"

PORT=3000

# Single shared back-office login (see auth.service.ts). ADMIN_PASSWORD_HASH
# is a bcrypt hash, not a plaintext password — generate one with:
#   node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional — email sending (registration verification, order confirmation,
# ticket transfer notices) is skipped with a log warning if unset.
RESEND_API_KEY=
# Optional — defaults to verify@mail.ts-annual-event.com.
EMAIL_FROM=
# Where every completed ticket-transfer admin notice goes. No default — a
# real person's address doesn't belong in the source tree. Unset means the
# notice is skipped with a warning; the transfer itself still completes.
TRANSFER_ADMIN_EMAIL=

# Optional — admin-facing AI image generation is disabled with a log
# warning if unset.
GEMINI_API_KEY=

# Optional — restricts CORS to an explicit comma-separated origin list
# instead of the built-in default allow-list (production domain, Vercel
# previews, localhost). See common/cors-origin.ts.
CORS_ORIGIN=

# Speed bump for the group-ticket queue, not a real secret — but no default,
# since one in the source tree is a passcode published to anyone who can read
# the repo. Required whenever any ticket type has requiresPasscode set: with
# it unset those queues fail closed and nobody can enter them.
GROUP_TICKET_PASSCODE=

# Never set this outside of an active k6 load test — it disables the
# anti-bot rate limiter entirely for every route. See rate-limit.guard.ts.
LOAD_TEST_MODE=
